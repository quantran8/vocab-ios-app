{"nodes": [{"id": "docs_color_palette_v2_doc", "label": "Syll Ink Palette (color-palette-v2)", "file_type": "document", "source_file": "docs/color-palette-v2.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_color_palette_v2_rule_60_30_10", "label": "60 \u00b7 30 \u00b7 10 Rule (White \u00b7 Ink \u00b7 Accent)", "file_type": "rationale", "source_file": "docs/color-palette-v2.html", "source_location": "1. T\u1ef7 l\u1ec7 60 \u00b7 30 \u00b7 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "60% white canvas and cards for breathing room, 30% Ink for text/Syllie/primary buttons/icons (visual weight rather than area; measured ~9%), 10% bright accent (Blue main, Green/Coral/Sun on context). Organisation borrowed from Brilliant, identity from Syllie's ink."}, {"id": "docs_color_palette_v2_ink_ramp", "label": "Ink Ramp (50-950, #131217)", "file_type": "concept", "source_file": "docs/color-palette-v2.html", "source_location": "2. D\u1ea3i m\u00e0u", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Very slightly purple-tinted black for text, Syllie, primary buttons, icons; never a card background. #171717 -> #131217."}, {"id": "docs_color_palette_v2_blue_ramp", "label": "Blue Ramp (accent, #3E68DB)", "file_type": "concept", "source_file": "docs/color-palette-v2.html", "source_location": "2. D\u1ea3i m\u00e0u", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single accent, slightly deeper than #4775F5: progress, selection, focus, links and practice-action buttons; white text passes AA."}, {"id": "docs_color_palette_v2_green_ramp", "label": "Green Ramp (success, #2BC86A)", "file_type": "concept", "source_file": "docs/color-palette-v2.html", "source_location": "2. D\u1ea3i m\u00e0u", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_color_palette_v2_coral_ramp", "label": "Coral Ramp (error, #FF5A3C)", "file_type": "concept", "source_file": "docs/color-palette-v2.html", "source_location": "2. D\u1ea3i m\u00e0u", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrong, needs practice, delete: warm and clear, not blood red."}, {"id": "docs_color_palette_v2_sun_ramp", "label": "Sun Ramp (reward, #FFB800)", "file_type": "concept", "source_file": "docs/color-palette-v2.html", "source_location": "2. D\u1ea3i m\u00e0u", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LP, stars, streaks, celebration (named amber in code)."}, {"id": "docs_color_palette_v2_collection_marks", "label": "Collection Marks (Everyday, Business, IELTS, TOEIC, My Words)", "file_type": "concept", "source_file": "docs/color-palette-v2.html", "source_location": "2. D\u1ea3i m\u00e0u", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One vivid tone per collection, used only as a small dot or icon glyph, never a card fill."}, {"id": "docs_color_palette_v2_token_map", "label": "Token Old -> New Mapping", "file_type": "concept", "source_file": "docs/color-palette-v2.html", "source_location": "3. Token c\u0169 \u2192 m\u1edbi", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep token names in Colors.swift, repoint values to ramp steps; adds successAction, errorAction, practiceAction, practiceDepth, collectionMark."}, {"id": "docs_color_palette_v2_practice_action", "label": "Practice Action Button (Blue 500 / Blue 700 depth)", "file_type": "rationale", "source_file": "docs/color-palette-v2.html", "source_location": "7. N\u00fat", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blue for every practice action: start lesson, Check, Practise again, play Challenge."}, {"id": "docs_color_palette_v2_primary_action", "label": "Primary Action Button (Ink 800 / Ink 950 depth)", "file_type": "rationale", "source_file": "docs/color-palette-v2.html", "source_location": "7. N\u00fat", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "General actions (sign in, save, add word, edit plan); not 900+ so the depth edge stays visible."}, {"id": "docs_color_palette_v2_feedback_buttons", "label": "Feedback Panel Buttons (Green 600 / Coral 600)", "file_type": "concept", "source_file": "docs/color-palette-v2.html", "source_location": "8. C\u1ea7n quy\u1ebft", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replace Ink to keep the game rhythm; white text meets large-bold 3:1."}, {"id": "docs_color_palette_v2_button_44pt", "label": "44pt Fully Rounded Buttons", "file_type": "rationale", "source_file": "docs/color-palette-v2.html", "source_location": "7. N\u00fat", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed 44pt (touch minimum) vs ~51pt current, capsule shape."}, {"id": "docs_color_palette_v2_borders_not_shadow", "label": "Borders, Not Shadows", "file_type": "rationale", "source_file": "docs/color-palette-v2.html", "source_location": "1. T\u1ef7 l\u1ec7 60 \u00b7 30 \u00b7 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cards and items get 2pt borders (1.5pt when light); depth edges only for emphasis: selected, correct, wrong, buttons."}, {"id": "docs_color_palette_v2_gamify_bright", "label": "Gamify With Bright Colour At The Right Moment", "file_type": "rationale", "source_file": "docs/color-palette-v2.html", "source_location": "1. T\u1ef7 l\u1ec7 60 \u00b7 30 \u00b7 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Duolingo/Brilliant-like: tinted correct/wrong panels, same-colour depth buttons, thick progress bars, sun-yellow stars and LP."}, {"id": "docs_color_palette_v2_text_with_meaning", "label": "Text Only When It Means Something", "file_type": "rationale", "source_file": "docs/color-palette-v2.html", "source_location": "1. T\u1ef7 l\u1ec7 60 \u00b7 30 \u00b7 10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_color_palette_v2_breathing_room", "label": "Breathing Room / No Pastel Everywhere", "file_type": "rationale", "source_file": "docs/color-palette-v2.html", "source_location": "1. T\u1ef7 l\u1ec7 60 \u00b7 30 \u00b7 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fewer parts per screen, wider spacing, white cards with thin borders; collections get one muted dot instead of recoloured cards."}, {"id": "docs_color_palette_v2_screen_mocks", "label": "Old vs Proposed Screen Mocks (Home, Task, Results)", "file_type": "concept", "source_file": "docs/color-palette-v2.html", "source_location": "4. Home", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_color_palette_v2_pixel_measure", "label": "Measured Home Colour Allocation", "file_type": "concept", "source_file": "docs/color-palette-v2.html", "source_location": "1. T\u1ef7 l\u1ec7 60 \u00b7 30 \u00b7 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old 86.1/13.1/0.7, proposed 83.1/9.3/7.6 (white/ink/accent)."}, {"id": "docs_color_palette_v2_contrast_check", "label": "WCAG Contrast Check Per Ramp Step", "file_type": "concept", "source_file": "docs/color-palette-v2.html", "source_location": "2. D\u1ea3i m\u00e0u", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_color_palette_v2_open_decisions", "label": "Open Decisions (HomeSyllie props, DESIGN_SYSTEM.md 4.1)", "file_type": "concept", "source_file": "docs/color-palette-v2.html", "source_location": "8. C\u1ea7n quy\u1ebft", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale