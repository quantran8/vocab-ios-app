    "Enter the email you signed up with. We’ll send you a code to set a new password." : {
      "comment" : "Explanation on the password reset screen.",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập email bạn đã dùng để đăng ký. Chúng tôi sẽ gửi mã để bạn đặt mật khẩu mới."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह ईमेल डालें जिससे आपने साइन अप किया था। नया पासवर्ड बनाने के लिए हम आपको एक कोड भेजेंगे।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce el correo con el que te registraste. Te enviaremos un código para crear una contraseña nueva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登録したメールアドレスを入力してください。新しいパスワードを設定するためのコードをお送りします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite o e-mail com que você se cadastrou. Enviaremos um código para definir uma nova senha."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가입할 때 사용한 이메일을 입력하세요. 새 비밀번호를 설정할 수 있는 코드를 보내 드릴게요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入你註冊時使用的電子郵件，我們會寄給你驗證碼，讓你設定新密碼。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรอกอีเมลที่คุณใช้สมัคร เราจะส่งรหัสให้เพื่อตั้งรหัสผ่านใหม่"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل البريد الإلكتروني الذي سجّلت به. سنرسل إليك رمزًا لتعيين كلمة مرور جديدة."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan email yang kamu gunakan untuk mendaftar. Kami akan mengirimkan kode untuk membuat kata sandi baru."
          }
        }
      }
    },
