    "Each finished learning or review part counts as one session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل جزء تعلّم أو مراجعة مكتمل يُحسب جلسة واحدة."
          }
        },
        "es" : {
          "stringUnit" : {
