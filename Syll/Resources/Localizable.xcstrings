    "Your plan is managed in the App Store. Cancel at least 24 hours before it renews to avoid being charged for the next period." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُدار خطتك في App Store. ألغِ قبل التجديد بـ 24 ساعة على الأقل حتى لا تُحاسَب على الفترة التالية."
          }
        },
        "es" : {
          "stringUnit" : {
