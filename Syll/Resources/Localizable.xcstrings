    "Leave it to start this one. It won’t count as a win." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غادره لتبدأ هذا. لن يُحتسب فوزًا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sal de él para empezar este. No contará como victoria."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे शुरू करने के लिए उसे छोड़ दें। वह जीत में नहीं गिना जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinggalkan yang itu untuk memulai yang ini. Yang itu tidak akan dihitung sebagai kemenangan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前のチャレンジを終了して、これを始めます。前のチャレンジは勝利に数えられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나가면 이 챌린지를 시작할 수 있어요. 승리로 집계되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saia dele para iniciar este. Não contará como vitória."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออกจากรอบนั้นเพื่อเริ่มรอบนี้ รอบนั้นจะไม่นับเป็นชัยชนะ"
          }
        },
        "vi" : {
