    "Only shown on the leaderboard if you join it. Your email is never shown." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر في لوحة الصدارة فقط إذا انضممت إليها. لا يظهر بريدك الإلكتروني أبدًا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
