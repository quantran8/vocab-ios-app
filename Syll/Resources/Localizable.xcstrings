    "You’ve learned every new word in %@. You can still review and practise them. Choose another collection to learn new words." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد تعلّمت كل الكلمات الجديدة في %@. لا يزال بإمكانك مراجعتها والتدرّب عليها. اختر مجموعة أخرى لتعلّم كلمات جديدة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has aprendido todas las palabras nuevas de %@. Aún puedes repasarlas y practicarlas. Elige otra colección para aprender palabras nuevas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने %@ के सभी नए शब्द सीख लिए। आप उन्हें अब भी दोहरा और अभ्यास कर सकते हैं। नए शब्द सीखने के लिए कोई दूसरा संग्रह चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu sudah mempelajari semua kata baru di %@. Kamu masih bisa mengulas dan melatihnya. Pilih koleksi lain untuk mempelajari kata baru."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の新しい単語をすべて学習しました。復習や練習は引き続きできます。新しい単語を学ぶには、別のコレクションを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 새 단어를 모두 학습했어요. 복습과 연습은 계속할 수 있어요. 새 단어를 학습하려면 다른 컬렉션을 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você aprendeu todas as palavras novas de %@. Ainda pode revisá-las e praticá-las. Escolha outra coleção para aprender palavras novas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณเรียนคำใหม่ใน %@ ครบแล้ว ยังทบทวนและฝึกได้อยู่ เลือกคอลเลกชันอื่นเพื่อเรียนคำใหม่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã học hết từ mới trong %@. Bạn vẫn ôn và luyện được từ đã học. Chọn Collection khác để học từ mới."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已學完%@的所有新單字。你仍可以複習和練習它們。選擇另一個單字集來學新單字。"
          }
        }
      }
    },
