        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 가깝다고 느껴지는 레벨을 선택하세요. 언제든 바꿀 수 있어요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選一個最接近你的程度，之後隨時都能更改。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกระดับที่ใกล้เคียงกับคุณที่สุด เปลี่ยนได้ทุกเมื่อ"
