          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ तब लीडरबोर्ड पर दिखता है जब आप जुड़ते हैं। आपका ईमेल कभी नहीं दिखाया जाता।"
          }
