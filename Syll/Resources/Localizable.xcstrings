            "value" : "Cada parte de aprendizaje o repaso completada cuenta como una sesión."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीखने या दोहराने का हर पूरा हिस्सा एक सत्र गिना जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
