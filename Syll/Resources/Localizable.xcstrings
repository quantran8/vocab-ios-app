    "Use 3–20 letters, numbers, “_” or “.”, starting with a letter." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم من 3 إلى 20 حرفًا أو رقمًا أو “_” أو “.”، على أن تبدأ بحرف."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa de 3 a 20 letras, números, “_” o “.”, empezando por una letra."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3–20 अक्षर, अंक, “_” या “.” इस्तेमाल करें, और शुरुआत अक्षर से करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan 3–20 huruf, angka, “_” atau “.”, diawali huruf."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3〜20文字の英字、数字、“_”、“.” を使い、先頭は英字にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문자로 시작하는 3–20자의 문자, 숫자, “_” 또는 “.”을 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use 3–20 letras, números, “_” ou “.”, começando com uma letra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ตัวอักษร ตัวเลข “_” หรือ “.” 3–20 ตัว โดยขึ้นต้นด้วยตัวอักษร"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng 3–20 ký tự gồm chữ, số, “_” hoặc “.”, bắt đầu bằng chữ cái."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使用 3–20 個字元，可用字母、數字、“_”或“.”，且必須以字母開頭。"
          }
        }
      }
    },
    "Use letters, spaces, hyphens and apostrophes, starting with a letter." : {
      "comment" : "Hint to display when a word contains invalid characters.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم الحروف والمسافات والواصلات والفواصل العليا، على أن تبدأ بحرف."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa letras, espacios, guiones y apóstrofos, empezando por una letra."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अक्षर, स्पेस, हाइफ़न और एपॉस्ट्रॉफ़ी इस्तेमाल करें, और शुरुआत अक्षर से करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan huruf, spasi, tanda hubung, dan apostrof, diawali huruf."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英字、スペース、ハイフン、アポストロフィを使い、先頭は英字にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문자로 시작하고 문자, 공백, 하이픈, 아포스트로피를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use letras, espaços, hifens e apóstrofos, começando com uma letra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ตัวอักษร ช่องว่าง ขีดกลาง และเครื่องหมายอัญประกาศเดี่ยว โดยขึ้นต้นด้วยตัวอักษร"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ dùng chữ cái, dấu cách, dấu gạch nối và dấu nháy đơn, bắt đầu bằng một chữ cái."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使用字母、空格、連字號和撇號，且必須以字母開頭。"
          }
        }
      }
