        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณเพิ่งเปลี่ยนชื่อไปเมื่อไม่นานมานี้ เปลี่ยนได้อีกครั้งภายหลัง"
