          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use 3–20 letras, números, “_” ou “.”, começando com uma letra."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문자로 시작하는 3–20자의 문자, 숫자, “_” 또는 “.”을 사용하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
