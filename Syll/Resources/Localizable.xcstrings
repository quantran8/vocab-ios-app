          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका प्लान App Store में मैनेज होता है। अगली अवधि का शुल्क न लगे, इसके लिए रिन्यूअल से कम से कम 24 घंटे पहले रद्द करें।"
