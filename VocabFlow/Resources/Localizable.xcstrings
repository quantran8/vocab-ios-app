    "That code is wrong or has expired. Check the latest email or send a new code." : {
      "comment" : "Error when the reset code is rejected.",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã không đúng hoặc đã hết hạn. Hãy xem email mới nhất hoặc gửi lại mã."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह कोड गलत है या उसकी अवधि खत्म हो गई है। नवीनतम ईमेल देखें या नया कोड भेजें।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese código es incorrecto o ha caducado. Revisa el último correo o envía un código nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードが正しくないか、有効期限が切れています。最新のメールを確認するか、コードを再送信してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse código está errado ou expirou. Confira o e-mail mais recente ou envie um novo código."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코드가 올바르지 않거나 만료됐어요. 최신 이메일을 확인하거나 새 코드를 보내 주세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驗證碼錯誤或已過期。請查看最新的郵件，或重新寄送驗證碼。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รหัสไม่ถูกต้องหรือหมดอายุแล้ว ตรวจสอบอีเมลล่าสุดหรือส่งรหัสใหม่"
