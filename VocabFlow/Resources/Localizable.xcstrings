    "Only shown on the leaderboard if you join it. Your email is never shown." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ hiện trên bảng xếp hạng nếu bạn tham gia. Email của bạn không bao giờ được hiển thị."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ तब लीडरबोर्ड पर दिखता है जब आप जुड़ते हैं। आपका ईमेल कभी नहीं दिखाया जाता।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se muestra en la clasificación si te unes. Tu correo nunca se muestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リーダーボードに参加した場合のみ表示されます。メールアドレスは表示されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só aparece no ranking se você participar. Seu e-mail nunca é exibido."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "순위표에 참여한 경우에만 표시돼요. 이메일은 절대 표시되지 않아요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你加入排行榜時才會顯示，你的電子郵件絕不會公開。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงบนอันดับเฉพาะเมื่อคุณเข้าร่วม อีเมลของคุณจะไม่ถูกแสดงเลย"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر في لوحة الصدارة فقط إذا انضممت إليها. لا يظهر بريدك الإلكتروني أبدًا."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya ditampilkan di papan peringkat jika kamu bergabung. Emailmu tidak pernah ditampilkan."
          }
        }
      }
    },
