          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ตัวอักษร ตัวเลข “_” หรือ “.” 3–20 ตัว โดยขึ้นต้นด้วยตัวอักษร"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم من 3 إلى 20 حرفًا أو رقمًا أو “_” أو “.”، على أن تبدأ بحرف."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan 3–20 huruf, angka, “_” atau “.”, diawali huruf."
          }
        }
      }
    },
    "Use letters, spaces, hyphens and apostrophes, starting with a letter." : {
      "comment" : "Hint to display when a word contains invalid characters.",
