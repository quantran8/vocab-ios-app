    "“%@” isn’t the word that means “%@” here. %lld attempts left — a hint can help." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” isn’t the word that means “%2$@” here. %3$lld attempts left — a hint can help."
