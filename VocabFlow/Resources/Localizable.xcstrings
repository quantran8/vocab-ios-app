    "Use 3–20 letters, numbers, “_” or “.”, starting with a letter." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng 3–20 ký tự gồm chữ, số, “_” hoặc “.”, bắt đầu bằng chữ cái."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3–20 अक्षर, अंक, “_” या “.” इस्तेमाल करें, और शुरुआत अक्षर से करें।"
          }
        },
        "es" : {
