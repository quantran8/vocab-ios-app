    "It joins your sessions once the translation is ready." : {
      "comment" : "A description of the translation status of a custom word.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستنضم إلى جلساتك عندما تصبح الترجمة جاهزة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se unirá a tus sesiones cuando la traducción esté lista."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुवाद तैयार होते ही यह आपके सत्रों में जुड़ जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata ini akan masuk ke sesimu setelah terjemahannya siap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳の準備ができ次第、セッションに加わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번역이 준비되면 세션에 포함돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela entra nas suas sessões quando a tradução estiver pronta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำนี้จะเข้าร่วมในเซสชันของคุณเมื่อคำแปลพร้อม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ này sẽ vào các buổi học khi bản dịch sẵn sàng."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻譯完成後，它就會加入你的練習。"
          }
        }
      }
    },
    "It took more than one try, so “%@” is listed for review." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتجت إلى أكثر من محاولة، لذا أُدرجت “%@” في قائمة المراجعة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitaste más de un intento, así que “%@” está en tu lista de repaso."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक से ज़्यादा कोशिशें लगीं, इसलिए “%@” दोहराव की सूची में है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Butuh lebih dari satu percobaan, jadi “%@” masuk ke daftar ulasan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正解までに複数回かかったため、“%@” を復習リストに入れました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 번 시도했기 때문에 “%@”이(가) 복습 목록에 추가됐어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foi preciso mais de uma tentativa, então “%@” está na lista de revisão."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องลองมากกว่าหนึ่งครั้ง จึงเพิ่ม “%@” ในรายการทบทวน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn cần nhiều hơn một lần thử, nên “%@” đã được đưa vào danh sách ôn tập."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你試了不只一次，所以“%@”已列入複習。"
          }
        }
      }
    },
    "It won’t be scheduled for review and your edits will be deleted. Your learning history stays." : {
      "comment" : "The body of a confirmation dialog that appears when the user tries to delete a custom word.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تُجدول للمراجعة وستُحذف تعديلاتك. يبقى سجل تعلّمك كما هو."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se programará para repaso y tus ediciones se eliminarán. Tu historial de aprendizaje se mantiene."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे दोहराव के लिए शेड्यूल नहीं किया जाएगा और आपके बदलाव मिट जाएँगे। आपका सीखने का इतिहास बना रहेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata ini tidak akan dijadwalkan untuk diulas dan perubahanmu akan dihapus. Riwayat belajarmu tetap tersimpan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復習の予定には入らず、編集内容も削除されます。学習履歴は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복습 일정에서 빠지고 편집한 내용은 삭제돼요. 학습 기록은 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela não será agendada para revisão e suas edições serão excluídas. Seu histórico de aprendizado continua."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำนี้จะไม่ถูกจัดเข้าตารางทบทวน และการแก้ไขของคุณจะถูกลบ ประวัติการเรียนยังอยู่เหมือนเดิม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ này sẽ không được lên lịch ôn và các chỉnh sửa của bạn sẽ bị xóa. Lịch sử học vẫn được giữ lại."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它不會再排入複習，你所做的編輯也會被刪除。你的學習紀錄會保留。"
          }
        }
      }
    },
