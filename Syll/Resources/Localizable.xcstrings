          }
        }
      }
    },
    "Tap a word, then its meaning, in either order. Wrong pairs only reset your combo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على كلمة ثم على معناها، أو العكس. الأزواج الخاطئة تعيد الكومبو فقط."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una palabra y luego su significado, en cualquier orden. Los pares incorrectos solo reinician tu combo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक शब्द पर टैप करें, फिर उसके अर्थ पर, किसी भी क्रम में। गलत जोड़ी से सिर्फ़ आपका कॉम्बो रीसेट होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk sebuah kata, lalu artinya, urutan bebas. Pasangan yang salah hanya mengatur ulang combo-mu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語とその意味を、どちらが先でもタップしてください。間違えてもコンボがリセットされるだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단어와 뜻을 순서에 상관없이 차례로 탭하세요. 틀린 짝은 콤보만 초기화돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma palavra e depois no significado, em qualquer ordem. Pares errados só zeram seu combo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะคำและความหมายของมัน จะแตะอันไหนก่อนก็ได้ จับคู่ผิดจะแค่รีเซ็ตคอมโบ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm một từ rồi chạm nghĩa của nó, theo thứ tự nào cũng được. Ghép sai chỉ làm mất chuỗi combo."
