        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma palavra para colocá-la aqui e depois verifique."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะแผ่นคำเพื่อวางไว้ตรงนี้ แล้วกดตรวจ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào một ô từ để đặt vào đây, rồi kiểm tra."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
