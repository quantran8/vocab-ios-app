    "You can’t add more words right now. Please try again later." : {
      "comment" : "Error message when the user tries to add more words while the limit is reached.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện bạn chưa thể thêm từ. Vui lòng thử lại sau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अभी और शब्द नहीं जोड़ सकते। कृपया बाद में फिर कोशिश करें।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes añadir más palabras ahora mismo. Inténtalo de nuevo más tarde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、これ以上単語を追加できません。しばらくしてからもう一度お試しください。"
