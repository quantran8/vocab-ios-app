            "state" : "translated",
            "value" : "राउंड कुछ देर बाद अपने आप बंद हो जाते हैं। मैप से नया शुरू करें।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las partidas se cierran pasado un tiempo. Empieza una nueva desde el mapa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイはしばらくすると終了します。マップから新しく始めてください。"
