    "One session isn’t mastery — come back to the words below in a day or two." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جلسة واحدة لا تعني الإتقان — عُد إلى الكلمات أدناه بعد يوم أو يومين."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sesión no es dominio — vuelve a las palabras de abajo en un día o dos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक सत्र से महारत नहीं आती — नीचे दिए शब्दों पर एक-दो दिन में फिर आएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu sesi belum cukup untuk menguasai — kembali ke kata-kata di bawah ini dalam satu atau dua hari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回のセッションで習得できるわけではありません。下の単語は、1〜2日後にもう一度見直しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번의 세션으로 완벽해지진 않아요. 아래 단어는 하루나 이틀 뒤에 다시 살펴보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma sessão não é domínio — volte às palavras abaixo em um ou dois dias."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซสชันเดียวยังไม่ทำให้เชี่ยวชาญ — กลับมาทบทวนคำด้านล่างอีกครั้งในอีกวันสองวัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một buổi học chưa đủ để thành thạo — hãy quay lại với các từ dưới đây sau một hai ngày."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次練習還稱不上精通，過一兩天再回來複習下面的單字吧。"
          }
        }
      }
    },
