    "Read words aloud in your lessons. Right or wrong, it never changes your progress." : {
      "comment" : "Routine setting note under the speaking toggle: speaking results never affect word progress.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ الكلمات بصوت عالٍ في دروسك. سواء أصبت أم أخطأت، لن يتغيّر تقدّمك أبدًا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee palabras en voz alta en tus lecciones. Aciertes o no, nunca cambia tu progreso."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने पाठों में शब्द ज़ोर से पढ़ें। सही हो या गलत, इससे आपकी प्रगति कभी नहीं बदलती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baca kata dengan lantang di pelajaranmu. Benar atau salah, progresmu tidak pernah berubah."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レッスンで単語を声に出して読みます。正解でも不正解でも、進捗には影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수업에서 단어를 소리 내어 읽어요. 맞든 틀리든 진도에는 영향이 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia palavras em voz alta nas lições. Certo ou errado, isso nunca muda seu progresso."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านคำออกเสียงในบทเรียน ถูกหรือผิดก็ไม่มีผลต่อความคืบหน้าของคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc to từ trong các bài học. Đúng hay sai đều không ảnh hưởng tiến độ học của bạn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在課程中大聲唸出單字。無論對錯，都不會改變你的進度。"
          }
        }
      }
    },
