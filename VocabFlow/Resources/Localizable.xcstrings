        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não pode adicionar mais palavras agora. Tente novamente mais tarde."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 단어를 더 추가할 수 없어요. 나중에 다시 시도해 주세요."
