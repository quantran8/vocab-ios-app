    "Signed up with Google or Apple? Log out and use “Forgot password?” to set a password." : {
      "comment" : "Hint on the change password sheet.",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng ký bằng Google hoặc Apple? Hãy đăng xuất rồi chọn “Quên mật khẩu?” để tạo mật khẩu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google या Apple से साइन अप किया था? लॉग आउट करें और पासवर्ड सेट करने के लिए “पासवर्ड भूल गए?” चुनें।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te registraste con Google o Apple? Cierra sesión y usa “¿Olvidaste tu contraseña?” para crear una contraseña."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GoogleまたはAppleで登録しましたか？ ログアウトして、“パスワードをお忘れですか？” からパスワードを設定してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadastrou-se com Google ou Apple? Saia da conta e use “Esqueceu a senha?” para definir uma senha."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google이나 Apple로 가입했나요? 로그아웃한 뒤 “비밀번호를 잊으셨나요?”로 비밀번호를 설정하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Google 或 Apple 帳號註冊的嗎？請先登出，再使用「忘記密碼？」來設定密碼。"
          }
        },
        "th" : {
