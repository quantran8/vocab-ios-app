    "Choose the level that feels closest. You can change it any time." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chọn trình độ gần với bạn nhất. Bạn có thể đổi bất cứ lúc nào."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो स्तर आपके सबसे करीब लगे, उसे चुनें। आप इसे कभी भी बदल सकते हैं।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el nivel que más se acerque al tuyo. Puedes cambiarlo cuando quieras."
