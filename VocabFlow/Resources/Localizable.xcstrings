      }
    },
    "You changed your name recently. You can change it again later." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn vừa đổi tên gần đây. Bạn có thể đổi lại sau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने हाल ही में अपना नाम बदला है। आप इसे बाद में फिर बदल सकते हैं।"
